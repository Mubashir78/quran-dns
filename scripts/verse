"""Fetch Qur'an verses over DNS for terminal display.

Human-first output on TTY (color, rules), plain logical text when piped.
Arabic rendering auto-detects the terminal: full-bidi terminals get logical
text, Kitty-like terminals get visual word order for their shaper, anything
else gets pre-shaped visual order. Override with --render or QDNS_RENDER.

Usage: scripts/verse [REF] [options]
  REF: 2:255 | 2:255-257 (max 20) | random | help
  No REF on a TTY opens an interactive prompt; piped with no REF prints help.
"""
from __future__ import annotations

import argparse
import json
import os
import random
import sys
from pathlib import Path

sys.path.insert(0, ".")

import dns.rcode  # noqa: E402

from qdns.client import build_name, fetch, fetch_many  # noqa: E402
from qdns.config import DEFAULT_LANG, LANGS, ZONE  # noqa: E402
from qdns.txt import join_txt  # noqa: E402

AYAH_COUNTS = [7, 286, 200, 176, 120, 165, 206, 75, 129, 109, 123, 111, 43, 52,
    99, 128, 111, 110, 98, 135, 112, 78, 118, 64, 77, 227, 93, 88, 69, 60, 34,
    30, 73, 54, 45, 83, 182, 88, 75, 85, 54, 53, 89, 59, 37, 35, 38, 29, 18, 45,
    60, 49, 62, 55, 78, 96, 29, 22, 24, 13, 14, 11, 11, 18, 12, 12, 30, 52, 52,
    44, 28, 28, 20, 56, 40, 31, 50, 40, 46, 42, 29, 19, 36, 25, 22, 17, 19, 26,
    30, 20, 15, 21, 11, 8, 8, 19, 5, 8, 8, 11, 11, 8, 3, 9, 5, 4, 7, 3, 6, 3,
    5, 4, 5, 6]

GOLD = "\033[33m"
DIM = "\033[2m"
END = "\033[0m"


def detect_render() -> str:
    """Terminal Arabic capability: full bidi, kitty-like, or none (visual)."""
    env = os.environ
    if "KITTY_WINDOW_ID" in env:
        return "kitty"          # harfbuzz per-word shaping, LTR word layout
    if any(k in env for k in ("VTE_VERSION", "KONSOLE_VERSION",
                              "WEZTERM_EXECUTABLE", "FOOT_WINDOW_ID",
                              "MLTERM", "WT_SESSION")):
        return "full"           # terminal does bidi + shaping itself
    if env.get("TERM_PROGRAM") in ("WezTerm", "Konsole", "foot", "mlterm"):
        return "full"
    return "visual"             # pre-shape to visual order ourselves


def for_terminal(text: str, lang: str, *, mode: str = "visual") -> str:
    if lang not in ("ar", "ur"):
        return text
    if mode == "full":
        return text             # terminal shapes and orders natively
    if mode == "kitty":
        # Kitty does not shape Arabic: pre-shape here in visual order.
        # Needs `force_ltr yes` in kitty.conf so kitty keeps our order.
        mode = "visual"
    import arabic_reshaper
    from bidi.algorithm import get_display
    reshaper = arabic_reshaper.ArabicReshaper(
        configuration={"delete_harakat": False})
    return get_display(reshaper.reshape(text))


def parse_ref(ref: str) -> list[tuple[int, int]]:
    """'2:255' -> [(2,255)]; '2:255-257' -> 3 tuples; 'random' -> 1 random."""
    ref = ref.strip().lower()
    if ref == "random":
        s = random.randint(1, 114)
        return [(s, random.randint(1, AYAH_COUNTS[s - 1]))]
    import re
    m = re.fullmatch(r"(\d{1,3})[:\-](\d{1,3})(?:-(\d{1,3}))?", ref)
    if not m:
        raise ValueError(f"bad ref {ref!r}: want S:A like 2:255, range 2:1-3, or 'random'")
    s, a, b = int(m.group(1)), int(m.group(2)), m.group(3)
    if not 1 <= s <= 114:
        raise ValueError(f"surah {s} out of range 1..114")
    if not 1 <= a <= AYAH_COUNTS[s - 1]:
        raise ValueError(f"ayah {a} out of range for surah {s} (1..{AYAH_COUNTS[s - 1]})")
    if b is None:
        return [(s, a)]
    b = int(b)
    if not a <= b <= AYAH_COUNTS[s - 1] or b - a > 19:
        raise ValueError(f"bad range {a}-{b}: max 20 verses within surah {s}")
    return [(s, i) for i in range(a, b + 1)]


def doh_fetch_many(base: str, names: list[str]):
    """All names over ONE HTTPS connection (was: one per pair)."""
    import base64
    import http.client
    import urllib.parse
    queries = [dns.message.make_query(n, "TXT") for n in names]
    parts = urllib.parse.urlsplit(base.rstrip("/") + "/dns-query")
    conn_cls = http.client.HTTPSConnection if parts.scheme == "https" \
        else http.client.HTTPConnection
    out = []
    conn = conn_cls(parts.hostname, parts.port or (443 if parts.scheme == "https" else 80),
                    timeout=15)
    with conn:
        for query in queries:
            b64 = base64.urlsafe_b64encode(query.to_wire()).rstrip(b"=").decode()
            conn.request("GET", parts.path + "?dns=" + b64,
                         headers={"Accept": "application/dns-message"})
            r = conn.getresponse()
            out.append(dns.message.from_wire(r.read()))
    return out


def show_human(s, a, texts: dict[str, str], *, color: bool, mode: str, plain: bool):
    head = f"◆ {s}:{a}"
    print(f"{GOLD}{head}{END}" if color else head)
    for lang, text in texts.items():
        print(text if plain else for_terminal(text, lang, mode=mode))
    print(f"{DIM}───{END}" if color else "───")


def run(ref: str, langs, args, color: bool) -> int:
    try:
        verses = parse_ref(ref)
    except ValueError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    pairs = [(s, a, la) for s, a in verses for la in langs]
    results: dict[tuple[int, int, str], str] = {}
    errors: dict[tuple[int, int, str], tuple[str, int]] = {}
    names = [build_name(f"{s}:{a}", la, ZONE) for s, a, la in pairs]

    def _record(pair, resp):
        s, a, la = pair
        if resp.rcode() == dns.rcode.NXDOMAIN:
            errors[pair] = (f"error: {s}:{a} {la}: not found", 1)
        elif resp.rcode() != dns.rcode.NOERROR or not resp.answer:
            errors[pair] = (f"error: {s}:{a} {la}: unexpected response", 1)
        else:
            results[pair] = join_txt(resp.answer[0][0])

    def _fail(exc):
        print(f"error: could not reach {args.server}:{args.port} ({exc})"
              if args.doh is None else f"error: DoH request failed ({exc})",
              file=sys.stderr)
        return 2

    if args.doh is not None:
        # One HTTPS connection for the whole batch (was: one per pair).
        try:
            resps = doh_fetch_many(args.doh, names)
        except Exception as exc:
            return _fail(exc)
        for pair, resp in zip(pairs, resps):
            _record(pair, resp)
    elif len(pairs) == 1:
        try:
            resp, _ = fetch(names[0], args.server, args.port, 3.0)
        except Exception as exc:
            return _fail(exc)
        _record(pairs[0], resp)
    else:
        # One TCP connection for the whole batch (was: one socket pair
        # per (verse, lang) via threads; TCP never truncates, so the
        # threads bought nothing but handshakes).
        try:
            resps = fetch_many(names, args.server, args.port, 3.0)
        except Exception as exc:
            return _fail(exc)
        for pair, resp in zip(pairs, resps):
            _record(pair, resp)
    if args.json:
        out = []
    for s, a in verses:
        texts = {}
        for la in langs:
            if (s, a, la) in errors:
                msg, code = errors[(s, a, la)]
                print(msg, file=sys.stderr)
                return code
            texts[la] = results[(s, a, la)]
        if args.json:
            out.append({"ref": f"{s}:{a}", **texts})
        else:
            show_human(s, a, texts, color=color, mode=args.render, plain=args.plain)
    if args.json:
        print(json.dumps(out if len(out) > 1 else out[0], ensure_ascii=False))
    return 0


HELP_LINE = "S:A | S:A-B | random | q · add langs after ref: 112:4 en"


def split_ref_langs(line: str, default_langs):
    parts = line.split()
    if parts and (parts[-1] == "all" or all(
            p in LANGS for p in parts[-1].split(","))):
        return " ".join(parts[:-1]), tuple(parts[-1].split(",")) \
            if parts[-1] != "all" else ("ar", "en")
    return line, default_langs


def repl(langs, args, color: bool) -> int:
    print("Qur'an over DNS. Type S:A, range, 'random', or q to quit.")
    try:
        import readline  # noqa: F401  (arrow-key history + editing)
        hist = Path(os.getenv("XDG_CACHE_HOME", Path.home() / ".cache")) / "qdns-verse-history"
        try:
            readline.read_history_file(hist)
        except FileNotFoundError:
            pass
        readline.set_history_length(200)
    except ImportError:
        hist = None
    while True:
        try:
            ref = input("verse> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if ref.lower() in ("q", "quit", "exit"):
            break
        if ref.lower() == "help":
            print(HELP_LINE)
            continue
        if not ref:
            continue
        ref, use_langs = split_ref_langs(ref, langs)
        if not ref:
            continue
        run(ref, use_langs, args, color)
    if hist is not None:
        try:
            hist.parent.mkdir(parents=True, exist_ok=True)
            readline.write_history_file(hist)
        except OSError:
            pass
    return 0


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(
        description="Fetch Qur'an verses over DNS.",
        epilog="examples:\n"
               "  scripts/verse 2:255\n"
               "  scripts/verse 112:4 all\n"
               "  scripts/verse 2:1-3 -l ar,en\n"
               "  scripts/verse random --json",
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("ref", nargs="?", help="S:A, S:A-B (max 20), random, help")
    ap.add_argument("-l", "--lang", default=None,
                    help=f"comma list or 'all'. choices: {','.join(LANGS)} (default ar,en)")
    ap.add_argument("--render", default=os.getenv("QDNS_RENDER", "auto"),
                    choices=("auto", "full", "kitty", "visual"),
                    help="Arabic shaping: auto-detect, terminal does all (full), "
                         "word-shape only like Kitty (kitty), pre-shape here (visual)")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    ap.add_argument("--no-color", action="store_true", help="disable color")
    ap.add_argument("--plain", action="store_true", help="skip Arabic reshaping")
    ap.add_argument("-s", "--server", default="127.0.0.1")
    ap.add_argument("-p", "--port", type=int, default=5453)
    ap.add_argument("--doh", default=None, metavar="BASE-URL",
                    help="use DNS-over-HTTPS instead of raw DNS, e.g. "
                         "--doh https://quran-reader-dns.loca.lt (worldwide, "
                         "no open ports needed)")
    args = ap.parse_args(argv)

    if args.lang in (None, "all"):
        langs = ("ar", "en")
    else:
        langs = tuple(args.lang.split(","))
        if not langs or any(la not in LANGS for la in langs):
            print(f"error: bad lang {args.lang!r} (choices: {','.join(LANGS)}, all)",
                  file=sys.stderr)
            return 2
    tty = sys.stdout.isatty() and sys.stdin.isatty()
    color = tty and not args.no_color and not os.getenv("NO_COLOR") and not args.json
    if args.render == "auto":
        args.render = detect_render()

    if args.ref is None:
        if not sys.stdin.isatty():
            ap.print_help()
            return 2
        return repl(langs, args, color)
    if args.ref.lower() == "help":
        ap.print_help()
        return 0
    return run(args.ref, langs, args, color)


if __name__ == "__main__":
    sys.exit(main())
